<?xml version="1.0" encoding="utf-8" ?>
<Defs>

<!-- Work types are listed in descending naturalPriority, the order they appear
     in the Work tab from left to right. -->

<!-- 1250 - Nurse -->

	<WorkTypeDef>
		<defName>DOL_Nurse</defName>
		<labelShort>Nurse</labelShort>
		<pawnLabel>Nurse</pawnLabel>
		<gerundLabel>Nursing</gerundLabel>
		<description>Care for the sick, bring them food, cheer them up, and perform assigned duties. Nurses will care for colonists, prisoners and animals.</description>
		<verb>Care for</verb>
		<naturalPriority>1250</naturalPriority>
		<requireCapableColonist>true</requireCapableColonist>
		<relevantSkills>
			<li>Medicine</li>
		</relevantSkills>
		<workTags>
			<li>Caring</li>
			<li>Commoner</li>
			<li>AllWork</li>
		</workTags>
	</WorkTypeDef>

