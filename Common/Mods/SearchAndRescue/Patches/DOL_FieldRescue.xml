<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!-- Search and Rescue - fold the Field Rescue work type into Doctor; its priority checks read Doctor's priority (Source/SearchAndRescue) -->
  <!-- Field Rescue jobs keep their order and sit above Doctor's own jobs, below tending to self -->
  <!-- Work mechs keep using Search and Rescue's own mech jobs, so the moved jobs stay humanlike-only -->
  <Operation Class="PatchOperationSequence">
    <operations>
      <li Class="PatchOperationReplace">
        <xpath>/Defs/WorkGiverDef[defName="SAR_RescueMarkedHauling"]/priorityInType</xpath>
        <value>
          <priorityInType>460</priorityInType>
        </value>
      </li>
      <li Class="PatchOperationReplace">
        <xpath>/Defs/WorkGiverDef[defName="SAR_TreatMarked" or defName="SAR_CaptureMarked" or defName="SAR_RepairMarkedMech" or defName="SAR_SupportiveCareMarkedNursing"]/priorityInType</xpath>
        <value>
          <priorityInType>420</priorityInType>
        </value>
      </li>
      <li Class="PatchOperationConditional">
        <xpath>/Defs/WorkGiverDef[defName="SAR_RescueMarkedParamedic"]</xpath>
        <match Class="PatchOperationReplace">
          <xpath>/Defs/WorkGiverDef[defName="SAR_RescueMarkedParamedic"]/priorityInType</xpath>
          <value>
            <priorityInType>419</priorityInType>
          </value>
        </match>
      </li>
      <li Class="PatchOperationReplace">
        <xpath>/Defs/WorkGiverDef[defName="SAR_AutomaticRoutineTreat"]/priorityInType</xpath>
        <value>
          <priorityInType>405</priorityInType>
        </value>
      </li>
      <li Class="PatchOperationConditional">
        <xpath>/Defs/WorkGiverDef[defName="SAR_RescueMarkedGrimWorks"]</xpath>
        <match Class="PatchOperationReplace">
          <xpath>/Defs/WorkGiverDef[defName="SAR_RescueMarkedGrimWorks"]/priorityInType</xpath>
          <value>
            <priorityInType>390</priorityInType>
          </value>
        </match>
      </li>
      <li Class="PatchOperationReplace">
        <xpath>/Defs/WorkGiverDef[defName="SAR_FollowupTreatMarked"]/priorityInType</xpath>
        <value>
          <priorityInType>385</priorityInType>
        </value>
      </li>
      <li Class="PatchOperationConditional">
        <xpath>/Defs/WorkGiverDef[defName="SAR_StrataRescueApproach"]</xpath>
        <match Class="PatchOperationReplace">
          <xpath>/Defs/WorkGiverDef[defName="SAR_StrataRescueApproach"]/priorityInType</xpath>
          <value>
            <priorityInType>380</priorityInType>
          </value>
        </match>
      </li>
      <li Class="PatchOperationConditional">
        <xpath>/Defs/WorkGiverDef[defName="SAR_RescueMarkedNursing"]</xpath>
        <match Class="PatchOperationReplace">
          <xpath>/Defs/WorkGiverDef[defName="SAR_RescueMarkedNursing"]/priorityInType</xpath>
          <value>
            <priorityInType>360</priorityInType>
          </value>
        </match>
      </li>
      <li Class="PatchOperationRemove">
        <xpath>/Defs/WorkGiverDef[workType="SAR_FieldRescue"]/canBeDoneByMechs</xpath>
      </li>
      <li Class="PatchOperationAdd">
        <xpath>/Defs/WorkGiverDef[workType="SAR_FieldRescue"]</xpath>
        <value>
          <canBeDoneByMechs>false</canBeDoneByMechs>
        </value>
      </li>
      <li Class="PatchOperationReplace">
        <xpath>/Defs/WorkGiverDef[workType="SAR_FieldRescue"]/workType</xpath>
        <value>
          <workType>Doctor</workType>
        </value>
      </li>
      <li Class="PatchOperationAdd">
        <xpath>/Defs/WorkTypeDef[defName="SAR_FieldRescue"]</xpath>
        <value>
          <visible>false</visible>
        </value>
      </li>
    </operations>
  </Operation>

</Patch>
